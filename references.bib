@article{hamiltonNonlinearScalingSpace2007,
  title = {Nonlinear Scaling of Space Use in Human Hunter--Gatherers},
  author = {Hamilton, Marcus J. and Milne, Bruce T. and Walker, Robert S. and Brown, James H.},
  year = 2007,
