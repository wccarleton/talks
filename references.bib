@article{yanUniversalModelIndividual2017,
  title = {Universal Model of Individual and Population Mobility on Diverse Spatial Scales},
  author = {Yan, Xiao-Yong and Wang, Wen-Xu and Gao, Zi-You and Lai, Ying-Cheng},
  year = 2017,
