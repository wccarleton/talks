  shorttitle = {Colonial {{Ideologies}}, {{Narratives}}, and {{Popular Perceptions}} of {{Ethno-racial Otherness}} in the {{Dynamics}} of {{Urban Exclusion}}},
  author = {{Ruiz-Tagle}, Javier and Aguilera, Carolina},
  year = 2021,
