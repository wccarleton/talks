@article{doveyInformalityUrFormUrbanity2025,
  title = {Informality as the {{Ur-Form}} of {{Urbanity}}: {{Keeping}} the {{Ur-}} in {{Urban Studies}}},
  author = {Dovey, Kim},
  year = 2025,
  month = jan,
  journal = {International Journal of Urban and Regional Research},
  volume = {49},
